{
  "schema_version": 1,
  "name": "sinusoidal_dipole_movie",
  "description": "Supplementary movie 2: time-resolved sinusoidal-dipole wave-field comparison.",
  "background_flow": "sinusoidal dipole",
  "supplementary_item": "movie 2",
  "models": ["YBJ", "TSB", "YBJ+", "PSE", "HBEs"],
  "controlled_comparison": {
    "background_velocity_m_s": 0.25,
    "horizontal_grid": [128, 128],
    "time_steps_per_inertial_period": 64,
    "time_step_parameter": "fc",
    "domain_depth_m": 2000,
    "vertical_wavelength_relation": "h=2H/n",
    "vertical_modes": [4, 16, 32],
    "vertical_wavelengths_m": [1000, 250, 125],
    "absolute_color_limits": {
      "4": [0.01, 37.5],
      "16": [0.39, 1.61],
      "32": [0.88, 1.12]
    },
    "times_in_inertial_periods": [0.0, 50.0],
    "physical_field_sample_interval_ip": 1.0,
    "physical_field_interpolation": false,
    "opening_page_count": 2,
    "opening_page_seconds": 2.0,
    "chapter_title_page_seconds": 4.0,
    "chapter_end_pause_seconds": 1.5,
    "absolute_colormap": "twilight_shifted",
    "difference_colormap": "RdBu_r",
    "manuscript_style_alignment": {
      "figures": [8, 9, 10],
      "preferred_text_font": "Times New Roman",
      "model_colors": {
        "YBJ": "#002BFF",
        "TSB": "#7A3E9D",
        "YBJ+": "#00C46A",
        "PSE": "#B2182B"
      },
      "nre_legend_visual_rows": [["YBJ", "TSB"], ["YBJ+", "PSE"]],
      "nre_y_limits_percent": {
        "4": [0, 40],
        "16": [0, 10],
        "32": [0, 10]
      },
      "subplot_title_fontsize": 20,
      "nre_title_fontsize": 17,
      "upper_row_quantity": "|phi|^2/|phi_amp|^2",
      "difference_quantity": "(|phi_model|^2-|phi_HBEs|^2)/|phi_amp|^2",
      "nre_quantity": "instantaneous complex-velocity NRE relative to HBEs",
      "title_card_alignment": {
        "reference": "supplementary movie 1",
        "reference_resolution": [1920, 1080],
        "reference_dpi": 120,
        "title_position": [0.5, 0.62],
        "subtitle_position": [0.5, 0.43],
        "reference_title_fontsize": 31,
        "reference_subtitle_fontsize": 20,
        "opening_page_count": 2,
        "opening_title": "Supplementary movie 2",
        "opening_subtitle": "Wave-field evolution in a sinusoidal-dipole background flow",
        "chapter_title_pattern": "Chapter {chapter}",
        "chapter_subtitle_pattern": "Vertical mode n={mode} (H=2 km; vertical wavelength h={wavelength} m); 0-50 inertial periods"
      }
    }
  },
  "steps": [
    {
      "name": "compute_movie_fields",
      "kind": "compute",
      "script": "code/sinusoidal_dipole/compute_movie_fields.py",
      "arguments": {
        "input": "artifacts/reproduction/full/data/simulation.h5",
        "output": "artifacts/reproduction/full/data/sinusoidal_dipole_movie_fields.npz",
        "difference_quantile": 0.995
      }
    },
    {
      "name": "render_wave_velocity_movie",
      "kind": "render",
      "script": "code/sinusoidal_dipole/render_wave_velocity_movie.py",
      "arguments": {
        "input": "artifacts/reproduction/full/data/sinusoidal_dipole_movie_fields.npz",
        "output_directory": "${output_directory}",
        "ffmpeg": "${ffmpeg?}",
        "ffprobe": "${ffprobe?}",
        "fps": "${fps?}",
        "resolution": "${resolution?}",
        "frame_stride": "${frame_stride?}",
        "hold_frames": "${hold_frames?}",
        "opening_seconds": "${opening_seconds?}",
        "title_seconds": "${title_seconds?}",
        "chapter_end_seconds": "${chapter_end_seconds?}",
        "crf": "${crf?}"
      }
    }
  ],
  "validation": {
    "type": "sinusoidal_dipole_movie",
    "uses_output_directory": true,
    "data": "artifacts/reproduction/full/data/sinusoidal_dipole_movie_fields.npz",
    "movie_filename": "movie2.mp4"
  }
}
