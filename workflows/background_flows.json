{
  "schema_version": 1,
  "name": "background_flows",
  "description": "Analytic background-flow fields used in Figure 3.",
  "background_flow": "parallel shear, Gaussian vortex and sinusoidal dipole",
  "figures": [3],
  "steps": [
    {
      "name": "compute_background_flows",
      "kind": "compute",
      "script": "code/background_flows/compute_background_flows.py",
      "arguments": {
        "grid_points": 256,
        "rossby_number": 0.05,
        "output": "artifacts/background_flows/data/background_flows.npz"
      }
    },
    {
      "name": "plot_background_flows",
      "kind": "plot",
      "script": "code/background_flows/plot_background_flows.py",
      "arguments": {
        "input": "artifacts/background_flows/data/background_flows.npz",
        "output": "artifacts/background_flows/figures/background_flows"
      }
    }
  ],
  "validation": {
    "type": "background_flows",
    "grid_points": 256,
    "rossby_number": 0.05,
    "data": "artifacts/background_flows/data/background_flows.npz",
    "metadata": "artifacts/background_flows/data/background_flows.json",
    "figure_stems": ["artifacts/background_flows/figures/background_flows"]
  }
}
