{
  "schema_version": 1,
  "name": "sinusoidal_dipole_wave",
  "description": "Sinusoidal-dipole wave-field comparison and Figures 9 and 10.",
  "background_flow": "sinusoidal dipole",
  "figures": [9, 10],
  "models": ["YBJ", "TSB", "YBJ+", "PSE", "HBEs"],
  "controlled_comparison": {
    "background_velocity_m_s": 0.25,
    "vertical_modes": [1, 4, 8, 16, 32],
    "times_in_inertial_periods": [10.0, 50.0]
  },
  "steps": [
    {
      "name": "compute_wave_velocity_fields",
      "kind": "compute",
      "script": "code/sinusoidal_dipole/compute_wave_velocity_fields.py",
      "arguments": {
        "input": "artifacts/reproduction/full/data/simulation.h5",
        "times": [10.0, 50.0],
        "output": "artifacts/reproduction/full/data/sinusoidal_dipole_wave_velocity_fields.npz"
      }
    },
    {
      "name": "plot_wave_velocity_fields",
      "kind": "plot",
      "script": "code/sinusoidal_dipole/plot_wave_velocity_fields.py",
      "supports_no_tex": true,
      "arguments": {
        "input": "artifacts/reproduction/full/data/sinusoidal_dipole_wave_velocity_fields.npz",
        "output_directory": "artifacts/reproduction/full/figures",
        "colormap": "twilight_shifted"
      }
    }
  ],
  "validation": {
    "type": "sinusoidal_dipole_wave",
    "data": "artifacts/reproduction/full/data/sinusoidal_dipole_wave_velocity_fields.npz",
    "figure_stems": [
      "artifacts/reproduction/full/figures/sinusoidal_dipole_wave_velocity_10IP",
      "artifacts/reproduction/full/figures/sinusoidal_dipole_wave_velocity_50IP"
    ],
    "figure_metadata": [
      "artifacts/reproduction/full/figures/sinusoidal_dipole_wave_velocity_10IP.json",
      "artifacts/reproduction/full/figures/sinusoidal_dipole_wave_velocity_50IP.json"
    ]
  }
}
